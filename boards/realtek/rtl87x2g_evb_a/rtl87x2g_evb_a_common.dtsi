#include "rtl87x2g_evb_a-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	compatible = "realtek,rtl87x2g_evb_a";

	chosen {
		zephyr,sram = &tcm0;
		zephyr,flash = &flash;
		zephyr,code-partition = &app_partition;
		zephyr,itcm = &tcm1;
		zephyr,console = &uart2;
		zephyr,shell-uart = &uart2;
	};

	aliases {
		led0 = &green_led;
		sw0 = &key2;
	};

	gpio_keys {
		compatible = "gpio-keys";

		key2: key2 {
			gpios = <&gpioa 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "KEY2";
			zephyr,code = <INPUT_KEY_0>;
		};

		key3: key3 {
			gpios = <&gpioa 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "KEY3";
			zephyr,code = <INPUT_KEY_1>;
		};

		key4: key4 {
			gpios = <&gpioa 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "KEY4";
			zephyr,code = <INPUT_KEY_2>;
		};

		key5: key5 {
			gpios = <&gpioa 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "KEY5";
			zephyr,code = <INPUT_KEY_3>;
		};
	};

	leds {
		compatible = "gpio-leds";
	
		led3: led_3 {
			gpios = <&gpioa 29 GPIO_ACTIVE_LOW>;
			label = "LED 3";
		};
	
		led4: led_4 {
			gpios = <&gpioa 30 GPIO_ACTIVE_LOW>;
			label = "LED 4";
		};
	
		led5: led_5 {
			gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
			label = "LED 5";
		};
	
		led7: led_7 {
			gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;
			label = "LED 7";
		};

		blue_led: blue_led {
			gpios = <&gpioa 30 GPIO_ACTIVE_LOW>;
			label = "Blue LED";
		};

		green_led: green_led {
			gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};

		red_led: red_led {
			gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};
	};
};

&gpioa {
	pinctrl-0 = <&gpioa_default>;
	pinctrl-names = "default";
	status = "okay";
};

&uart2 {
	pinctrl-0 = <&uart2_default>;
	pinctrl-names = "default";
	status = "okay";
	current-speed = <115200>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
};

&cpu {
	clock-frequency = <40000000>;
};
